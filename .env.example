# Copy this file to ".env" and fill in your keys.
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore) so your keys never get committed.

# Groq — powers both speech-to-text (Whisper) and the interviewer LLM.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# ElevenLabs — powers text-to-speech.
# Get one at https://elevenlabs.io  (Profile -> API Keys)
ELEVENLABS_API_KEY=
