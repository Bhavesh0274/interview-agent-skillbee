# Copy this file to ".env" and fill in your key(s).
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore) so your keys never get committed.

# Groq — powers speech-to-text (Whisper) AND the interviewer LLM.
# This is the ONLY key you need with the default (free) Edge TTS.
# Get one for free at https://console.groq.com/keys
GROQ_API_KEY=

# ElevenLabs — OPTIONAL. Only needed if you switch tts.provider to "elevenlabs"
# in config.yaml for higher-quality voices. Leave blank to use free Edge TTS.
# https://elevenlabs.io  (Profile -> API Keys)
ELEVENLABS_API_KEY=
